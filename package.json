{
  "name": "bookify-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api:validate": "node scripts/validate-openapi.mjs",
    "api:generate": "openapi-typescript contracts/booking-v1.openapi.json -o src/lib/api/generated/booking-v1.d.ts",
    "api:check": "openapi-typescript contracts/booking-v1.openapi.json -o src/lib/api/generated/booking-v1.d.ts --check"
  },
  "dependencies": {
    "jose": "6.2.15",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "openapi-typescript": "7.13.0",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.1"
}
