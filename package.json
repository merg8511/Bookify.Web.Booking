{
  "name": "bookify-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "api:validate": "node scripts/validate-openapi.mjs",
    "api:generate": "openapi-typescript contracts/booking-v1.openapi.json -o src/lib/api/generated/booking-v1.d.ts",
    "api:check": "openapi-typescript contracts/booking-v1.openapi.json -o src/lib/api/generated/booking-v1.d.ts --check",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:all": "pnpm lint && pnpm typecheck && pnpm api:validate && pnpm api:check && pnpm test:coverage && pnpm build && pnpm test:e2e"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "jose": "6.2.15",
    "next": "16.4.5",
    "next-auth": "5.0.0-beta.32",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "jsdom": "30.1.3",
    "openapi-typescript": "7.13.0",
    "typescript": "^5",
    "vitest": "5.1.0"
  },
  "packageManager": "pnpm@10.28.1"
}
