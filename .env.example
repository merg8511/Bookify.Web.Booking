# Bookify Backend
BOOKIFY_API_BASE_URL=https://localhost:7071

# MÓDULO 25.5 — OIDC
#
# El issuer debe coincidir con Identity:Authority
# configurado en el backend.
#
# Ejemplo de formato para Keycloak:
# https://identity.example.com/realms/bookify
#
# No representa un proveedor desplegado.

BOOKIFY_OIDC_ISSUER=

# Debe coincidir con Identity:Audience del backend.
BOOKIFY_API_AUDIENCE=

# Credenciales del cliente OIDC registrado
# para esta aplicación Next.js.
AUTH_BOOKIFY_ID=
AUTH_BOOKIFY_SECRET=

# Generar localmente. Nunca versionar su valor real.
AUTH_SECRET=

# MÓDULO 25.6 — Guest booking credential
#
# Clave independiente de AUTH_SECRET.
# Debe representar exactamente 32 bytes aleatorios
# mediante Base64 estándar.
#
# Nunca versionar el valor verdadero.
# Utilizar una clave distinta por entorno.

BOOKIFY_GUEST_COOKIE_KEY=